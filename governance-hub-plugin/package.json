{
  "name": "@mcombi/backstage-plugin-governance-hub",
  "version": "0.1.0",
  "description": "RHDH dynamic plugin that embeds the Governance Hub — visible to architects only",
  "private": true,
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "backstage-cli package build",
    "export-dynamic": "janus-cli package export-dynamic-plugin --clean",
    "build-and-export": "npm run tsc && npm run build && npm run export-dynamic",
    "tsc": "tsc --skipLibCheck"
  },
  "dependencies": {
    "@backstage/core-components": "^0.14.4",
    "@backstage/core-plugin-api": "^1.9.3",
    "@backstage/plugin-permission-react": "^0.4.21",
    "@backstage/plugin-permission-common": "^0.7.13",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.26.4",
    "@janus-idp/cli": "^1.13.1",
    "@red-hat-developer-hub/cli": "^1.11.4",
    "@types/react": "^18.0.2",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "files": [
    "dist",
    "dist-dynamic",
    "config.d.ts"
  ],
  "backstage": {
    "role": "frontend-plugin"
  },
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "govHub": {
        "type": "object",
        "description": "Governance Hub plugin configuration",
        "properties": {
          "url": {
            "type": "string",
            "visibility": "frontend",
            "description": "URL of the Governance Hub service embedded in the RHDH iframe. Injected via GOVERNANCE_HUB_URL from rhdh-secrets."
          }
        },
        "required": ["url"]
      }
    }
  },
  "scalprum": {
    "name": "mcombi.backstage-plugin-governance-hub",
    "exposedModules": {
      "PluginRoot": "./src/index.ts"
    }
  }
}
